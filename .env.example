# Copy to .env and fill in. NEVER commit .env or paste private keys in chat.
# Testnet accounts: https://portal.hedera.com (export keys as DER).

# Network
HEDERA_NETWORK=hedera:testnet
MIRROR_URL=https://testnet.mirrornode.hedera.com
FACILITATOR_URL=https://api.testnet.blocky402.com   # fallback: https://x402.org/facilitator
USDC_TOKEN_ID=0.0.429274

# Hedera accounts (DER-encoded private keys).
# Only GATEWAY is required up front: use your portal.hedera.com testnet account.
# `npm run setup` creates VAULT, AGENT and MERCHANT from it and prints their lines to paste here.
GATEWAY_ACCOUNT_ID=
GATEWAY_PRIVATE_KEY=
VAULT_ACCOUNT_ID=
VAULT_PRIVATE_KEY=
AGENT_ACCOUNT_ID=
AGENT_PRIVATE_KEY=
MERCHANT_ACCOUNT_ID=          # demo merchants' payout account
MERCHANT_PRIVATE_KEY=
HCS_TOPIC_ID=                 # printed by `npm run setup`

# Arkiv (Rabdi testnet). Leave empty to disable Arkiv writes.
ARKIV_ACCESS_KEY=
ARKIV_PRIVATE_KEY=            # 0x EVM key, separate from Hedera keys
ARKIV_WRITER_ADDRESS=         # public address of the writer key (demo agent reads with this)

# World ID (IDKit 4). Leave empty to use DEMO_MODE dev login.
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=
WORLD_ENVIRONMENT=staging
NEXT_PUBLIC_WORLD_APP_ID=
NEXT_PUBLIC_WORLD_ENVIRONMENT=staging

# App
JWT_SECRET=change-me
DATABASE_PATH=./data/app.db
FEE_BPS=200
PENALTY_BPS=2000
DEMO_MODE=true                # allows http merchant URLs, seeded merchants, dev login

# Ports / URLs
GATEWAY_PORT=4000
MERCHANTS_PORT=4100
AGENT_PORT=4200
GATEWAY_URL=http://localhost:4000
MERCHANTS_URL=http://localhost:4100
DEMO_AGENT_URL=http://localhost:4200
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_HASHSCAN_URL=https://hashscan.io/testnet
DEMO_AGENT_KEY=               # printed by `npm run seed`

# World ID Agent Pass (OIDC, auth.world.org). Callback must be HTTPS and match exactly.
WORLD_OIDC_CLIENT_ID=
WORLD_OIDC_CLIENT_SECRET=
WORLD_OIDC_REDIRECT_URI=      # https://<host>/api/world/oidc/callback

# Dev only: set when your tunnel points at the gateway (4000) instead of the web app (3000).
# WEB_DEV_PROXY=http://localhost:3000

# Demo pricing (testnet). Defaults are 0.10 USDC per call with 1.5 USDC bonds.
# DEMO_PRICE_MICRO=100000
# DEMO_PRICE_USDC=0.10
# SEED_BOND_USDC=1.5
